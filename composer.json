{
    "name": "ol1xy/interactive-content-project",
    "description": "Educational project demonstrating PHP dependency management with Composer",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "ol1xy",
            "role": "Student"
        }
    ],
    "require": {
        "php": ">=8.2",
        "illuminate/database": "^11.0",
        "predis/predis": "^2.2",
        "phpoffice/phpspreadsheet": "^2.0",
        "dompdf/dompdf": "^3.0",
        "zelenin/smsru": "^5.0",
        "symfony/mailer": "^7.0",
        "aws/aws-sdk-php": "^3.0",
        "league/oauth2-client": "^2.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {},
        "platform": {
            "php": "8.3.0",
            "ext-gd": "2.3.0"
        }
    }
}
